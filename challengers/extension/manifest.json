{
  "manifest_version": 3,
  "name": "ChaLLengErs – Free CV Tailor",
  "short_name": "ChaLLengErs",
  "version": "1.1.0",
  "description": "Tailor your CV to any job ad, see ATS keywords, save jobs with a match score, and autofill application forms. Free and private.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_popup": "popup.html", "default_title": "ChaLLengErs", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "scripting", "contextMenus"]
}
